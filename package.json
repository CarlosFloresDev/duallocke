{
  "name": "duallocke",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:full": "astro build && wrangler pages dev",
    "build": "astro build",
    "preview": "wrangler pages dev",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply duallocke --local",
    "db:migrate": "wrangler d1 migrations apply duallocke --remote",
    "deploy": "astro build && wrangler pages deploy dist --project-name duallocke --branch main"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "astro": "^5.18.2",
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261120.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
