---
import Layout from '../layouts/Layout.astro';

const art = (id: number) => `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`;

const steps = [
  { n: '1', title: 'Capturen', text: 'Cada uno atrapa el primer Pokémon de la misma ruta.' },
  { n: '2', title: 'Vincúlenlos', text: 'Esos dos Pokémon quedan unidos para toda la partida.' },
  { n: '3', title: 'Sobrevivan', text: 'Si uno cae, su pareja también. Ganan o pierden juntos.' },
];

const rules = [
  { tag: 'Nuzlocke', text: 'Solo el primer encuentro de cada ruta.' },
  { tag: 'Nuzlocke', text: 'Si se debilita, está muerto.' },
  { tag: 'Nuzlocke', text: 'Ponle apodo a todos.' },
  { tag: 'Soul Link', text: 'Sin captura de uno, se pierde la ruta para los dos.' },
  { tag: 'Soul Link', text: 'Si un vinculado muere, su pareja va al PC.' },
  { tag: 'Soul Link', text: 'Al PC se va en pareja, nunca solo.' },
  { tag: 'Soul Link', text: 'Ningún gimnasio sin que el otro esté listo.' },
  { tag: 'Opcional', text: 'Tipos únicos entre ambos equipos.' },
  { tag: 'Opcional', text: 'Randomizer para encuentros imprevisibles.' },
];

const emulators = [
  { name: 'mGBA', platform: 'PC', consoles: 'GBA', note: 'Multijugador en la misma PC', url: 'https://mgba.io/downloads.html' },
  { name: 'MelonDS', platform: 'PC · Android', consoles: 'NDS', note: 'Wi-Fi local para la Sala Unión', url: 'https://melonds.kuribo64.net/' },
  { name: 'DraStic', platform: 'Android', consoles: 'NDS', note: 'El más rápido en móvil, gratis', url: 'https://github.com/R-YaTian/DraStic_rev_i18n/releases' },
  { name: 'My Boy!', platform: 'Android', consoles: 'GBA', note: 'Link por Wi-Fi o Bluetooth', url: null },
  { name: 'Delta', platform: 'iOS', consoles: 'GBA · NDS', note: 'Desde la App Store, sin jailbreak', url: 'https://apps.apple.com/app/delta-game-emulator/id1048524688' },
];

const tips = [
  { title: 'Hablen por voz', text: 'Coordinar en vivo hace cada encuentro más tenso.' },
  { title: 'Save state de emergencia', text: 'Solo ante un crash, nunca para repetir combates.' },
  { title: 'Un gimnasio por sesión', text: 'Avancen al mismo ritmo y esperen al otro.' },
  { title: 'Avisen cada muerte', text: 'Paren y marquen el vínculo en el tracker.' },
];

const regions = ['Kanto', 'Johto', 'Hoenn', 'Sinnoh', 'Teselia'];
---

<Layout title="Guía" description="Juega un Nuzlocke Soul Link en pareja: reglas en un minuto, emuladores recomendados y un tracker en vivo para tus vínculos, vidas y gimnasios.">
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"><div class="ring"></div><div class="grid-bg"></div></div>
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="eyebrow reveal">Nuzlocke cooperativo para dos</p>
        <h1 class="reveal" style="--d:80ms">Atrapen juntos.<br /><span class="red">Pierdan juntos.</span></h1>
        <p class="lead reveal" style="--d:160ms">Reglas en un minuto, emuladores probados y un tracker en vivo para tu Soul Link.</p>
        <div class="cta reveal" style="--d:240ms">
          <a href="/tracker" class="btn-primary">Abrir tracker</a>
          <a href="/instalacion" class="btn-secondary">Cómo instalar</a>
        </div>
        <ul class="regions reveal" style="--d:320ms" aria-label="Regiones disponibles">
          {regions.map((r) => <li>{r}</li>)}
        </ul>
      </div>

      <div class="duo" aria-hidden="true">
        <div class="mon mon-a"><img src={art(25)} alt="" width="220" height="220" /><span class="tag tag-a">Jugador 1</span></div>
        <svg class="chain" viewBox="0 0 120 40" preserveAspectRatio="none">
          <path d="M0 20 Q 60 -6 120 20" />
          <path class="pulse" d="M0 20 Q 60 -6 120 20" />
        </svg>
        <div class="mon mon-b"><img src={art(133)} alt="" width="220" height="220" /><span class="tag tag-b">Jugador 2</span></div>
        <div class="lives"><span>♥</span><span>♥</span><span>♥</span></div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section id="como-funciona" class="block">
      <h2 class="reveal">Cómo funciona</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step reveal tilt" style={`--d:${i * 90}ms`}>
            <span class="step-n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="reglas" class="block">
      <h2 class="reveal">Reglas</h2>
      <p class="sub reveal">Las estándar. Acuerden los cambios antes de empezar.</p>
      <ul class="rules">
        {rules.map((r, i) => (
          <li class={`rule reveal rule-${r.tag === 'Nuzlocke' ? 'base' : r.tag === 'Soul Link' ? 'link' : 'opt'}`} style={`--d:${i * 40}ms`}>
            <span class="rule-tag">{r.tag}</span>
            <span>{r.text}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="tracker" class="block showcase">
      <div class="showcase-copy reveal">
        <h2>Todo el Soul Link en un solo lugar</h2>
        <ul class="checks">
          <li>Crea una run y comparte un código de 6 letras.</li>
          <li>Registra capturas con los encuentros de cada ruta.</li>
          <li>Vidas compartidas que se descuentan solas.</li>
          <li>Gimnasios y equipo de los dos, sincronizados.</li>
        </ul>
        <a href="/tracker" class="btn-primary">Crear mi run</a>
      </div>
      <div class="showcase-media reveal tilt" style="--d:120ms">
        <div class="mock">
          <div class="mock-bar"><span></span><span></span><span></span></div>
          <div class="mock-body">
            <div class="mock-route">Ruta 201 <em>Vivo</em></div>
            <div class="mock-pair">
              <figure><img src={art(396)} alt="Starly" width="96" height="96" loading="lazy" /><figcaption>Starly</figcaption></figure>
              <span class="mock-link">⇄</span>
              <figure><img src={art(399)} alt="Bidoof" width="96" height="96" loading="lazy" /><figcaption>Bidoof</figcaption></figure>
            </div>
            <div class="mock-stats">
              <span>Gimnasios <b>3/8</b></span>
              <span>Muertes <b class="red">1</b></span>
              <span class="hearts">♥ ♥ <i>♥</i></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="emuladores" class="block">
      <h2 class="reveal">Emuladores</h2>
      <p class="sub reveal">Gratis y probados para Soul Link. <a href="/instalacion" class="inline-link">Guía de instalación paso a paso →</a></p>
      <ul class="emus">
        {emulators.map((e, i) => (
          <li class="emu reveal tilt" style={`--d:${i * 60}ms`}>
            <div class="emu-top">
              <h3>{e.name}</h3>
              <span class="pill">{e.consoles}</span>
            </div>
            <p class="emu-platform">{e.platform}</p>
            <p class="emu-note">{e.note}</p>
            {e.url ? <a href={e.url} target="_blank" rel="noopener" class="emu-link">Descargar ↗</a> : <span class="emu-link muted">Google Play</span>}
          </li>
        ))}
      </ul>
      <p class="hint reveal">¿Intercambios en móvil? Pasen el archivo .sav a una PC solo para el intercambio.</p>
    </section>

    <section id="tips" class="block">
      <h2 class="reveal">Tips</h2>
      <ul class="tips">
        {tips.map((t, i) => (
          <li class="tip reveal" style={`--d:${i * 70}ms`}>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="final reveal">
      <h2>¿Listos para la primera ruta?</h2>
      <a href="/tracker" class="btn-primary">Abrir tracker</a>
    </section>
  </div>
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: radial-gradient(ellipse at 70% 30%, rgba(230, 57, 70, 0.14), transparent 60%), var(--dark);
  }
  .hero-bg { position: absolute; inset: 0; pointer-events: none; }
  .grid-bg {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse at 60% 40%, #000 20%, transparent 75%);
  }
  .ring {
    position: absolute;
    width: 560px;
    height: 560px;
    right: -120px;
    top: -140px;
    border-radius: 50%;
    border: 48px solid rgba(230, 57, 70, 0.06);
    box-shadow: inset 0 0 0 1px rgba(230, 57, 70, 0.05);
    animation: spin 60s linear infinite;
  }
  .hero-inner {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    padding: 72px 20px 80px;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 40px;
    align-items: center;
  }
  .eyebrow { font-family: 'Press Start 2P', monospace; font-size: 10px; color: var(--yellow); margin: 0 0 20px; }
  h1 {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(20px, 2.6vw, 30px);
    line-height: 1.45;
    margin: 0;
    color: var(--text);
    text-shadow: 4px 4px 0 rgba(0, 0, 0, 0.6);
  }
  .red { color: var(--red); }
  .lead { font-size: 17px; color: var(--muted); max-width: 44ch; margin: 22px 0 0; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .cta .btn-primary, .cta .btn-secondary { font-size: 10px; padding: 15px 22px; }
  .regions { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 28px 0 0; }
  .regions li { font-size: 12px; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 3px 12px; }

  .duo { position: relative; height: 340px; }
  .mon { position: absolute; top: 40px; display: grid; justify-items: center; gap: 8px; }
  .mon img { width: min(200px, 34vw); height: auto; filter: drop-shadow(0 18px 24px rgba(0, 0, 0, 0.6)); }
  .mon-a { left: 0; animation: bob 3.2s ease-in-out infinite; }
  .mon-b { right: 0; animation: bob 3.2s ease-in-out 1.6s infinite; }
  .tag { font-family: 'Press Start 2P', monospace; font-size: 8px; padding: 5px 8px; border-radius: 3px; color: #000; }
  .tag-a { background: var(--red); color: #fff; }
  .tag-b { background: var(--blue); color: #fff; }
  .chain { position: absolute; left: 28%; right: 28%; top: 150px; width: 44%; height: 60px; overflow: visible; }
  .chain path { fill: none; stroke: #444; stroke-width: 2; stroke-dasharray: 6 6; }
  .chain .pulse { stroke: var(--yellow); stroke-width: 3; stroke-dasharray: 18 200; animation: flow 2.2s linear infinite; }
  .lives { position: absolute; left: 50%; bottom: 10px; transform: translateX(-50%); display: flex; gap: 8px; font-size: 22px; color: var(--red); }
  .lives span { animation: beat 1.6s ease-in-out infinite; }
  .lives span:nth-child(2) { animation-delay: 0.15s; }
  .lives span:nth-child(3) { animation-delay: 0.3s; }

  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
  .block { padding-top: 96px; }
  h2 { font-family: 'Press Start 2P', monospace; font-size: clamp(15px, 2vw, 20px); line-height: 1.5; color: var(--yellow); margin: 0 0 12px; }
  .sub { color: var(--muted); margin: 0 0 28px; }
  .inline-link { color: var(--yellow); text-decoration: none; border-bottom: 1px solid transparent; }
  .inline-link:hover { border-color: currentColor; }

  .steps { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .step { position: relative; background: var(--panel); border: 1px solid var(--border); border-radius: 6px; padding: 28px 24px; }
  .step-n {
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 4px;
    background: var(--red); color: #fff; font-family: 'Press Start 2P', monospace; font-size: 13px; margin-bottom: 18px;
    box-shadow: 0 0 0 4px rgba(230, 57, 70, 0.15);
  }
  .step h3 { font-family: 'Press Start 2P', monospace; font-size: 11px; color: var(--text); margin: 0 0 10px; }
  .step p { color: var(--muted); margin: 0; font-size: 14px; }

  .rules { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .rule {
    display: grid; gap: 8px; background: var(--panel); border: 1px solid var(--border); border-left-width: 3px;
    border-radius: 4px; padding: 14px 16px; font-size: 14px; transition: transform 0.2s, background 0.2s;
  }
  .rule:hover { transform: translateX(4px); background: #1b1b1b; }
  .rule-tag { font-family: 'Press Start 2P', monospace; font-size: 7px; letter-spacing: 1px; }
  .rule-base { border-left-color: var(--red); } .rule-base .rule-tag { color: var(--red); }
  .rule-link { border-left-color: var(--yellow); } .rule-link .rule-tag { color: var(--yellow); }
  .rule-opt { border-left-color: var(--blue); } .rule-opt .rule-tag { color: var(--blue); }

  .showcase { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .checks { list-style: none; padding: 0; margin: 20px 0 28px; display: grid; gap: 12px; }
  .checks li { padding-left: 28px; position: relative; color: var(--text); }
  .checks li::before { content: '✓'; position: absolute; left: 0; color: var(--green); font-weight: 700; }
  .mock { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.8); }
  .mock-bar { display: flex; gap: 6px; padding: 10px 12px; border-bottom: 1px solid var(--border); }
  .mock-bar span { width: 10px; height: 10px; border-radius: 50%; background: #333; }
  .mock-bar span:first-child { background: var(--red); }
  .mock-body { padding: 22px; display: grid; gap: 18px; }
  .mock-route { display: flex; justify-content: space-between; font-family: 'Press Start 2P', monospace; font-size: 10px; }
  .mock-route em { font-style: normal; color: var(--green); border: 1px solid rgba(45, 198, 83, 0.4); padding: 3px 6px; font-size: 8px; }
  .mock-pair { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; text-align: center; }
  .mock-pair figure { margin: 0; display: grid; justify-items: center; gap: 4px; }
  .mock-pair img { animation: bob 3s ease-in-out infinite; }
  .mock-pair figure:last-child img { animation-delay: 1.5s; }
  .mock-pair figcaption { font-size: 13px; font-weight: 700; }
  .mock-link { font-family: 'Press Start 2P', monospace; color: var(--yellow); animation: beat 1.6s ease-in-out infinite; }
  .mock-stats { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; font-size: 12px; color: var(--muted); border-top: 1px solid var(--border); padding-top: 14px; }
  .mock-stats b { color: var(--text); font-family: 'Press Start 2P', monospace; font-size: 10px; margin-left: 6px; }
  .mock-stats .red { color: var(--red); }
  .hearts { color: var(--red); letter-spacing: 2px; }
  .hearts i { font-style: normal; color: #333; }

  .emus { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  .emu { background: var(--panel); border: 1px solid var(--border); border-radius: 6px; padding: 18px; display: grid; gap: 6px; align-content: start; }
  .emu-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .emu h3 { font-family: 'Press Start 2P', monospace; font-size: 10px; margin: 0; color: var(--text); }
  .pill { font-size: 10px; color: var(--yellow); border: 1px solid rgba(255, 214, 10, 0.3); border-radius: 999px; padding: 1px 8px; white-space: nowrap; }
  .emu-platform { margin: 0; font-size: 12px; color: var(--blue); }
  .emu-note { margin: 0 0 8px; font-size: 13px; color: var(--muted); line-height: 1.5; }
  .emu-link { font-size: 13px; font-weight: 700; color: var(--text); text-decoration: none; margin-top: auto; }
  .emu-link:hover { color: var(--yellow); }
  .emu-link.muted { color: var(--muted); font-weight: 400; }
  .hint { margin-top: 18px; color: var(--muted); font-size: 13px; }

  .tips { list-style: none; padding: 0; margin: 24px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
  .tip { background: var(--panel); padding: 22px; transition: background 0.2s; }
  .tip:hover { background: #1b1b1b; }
  .tip h3 { font-size: 15px; margin: 0 0 6px; color: var(--text); }
  .tip p { margin: 0; color: var(--muted); font-size: 14px; }

  .final { margin-top: 96px; padding: 56px 24px; text-align: center; border: 1px solid var(--border); border-radius: 8px;
    background: radial-gradient(ellipse at 50% 0%, rgba(255, 214, 10, 0.1), transparent 70%), var(--panel); display: grid; justify-items: center; gap: 22px; }
  .final h2 { color: var(--text); margin: 0; }

  .tilt { transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s; }
  .tilt:hover { border-color: #444; }

  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
  @keyframes flow { from { stroke-dashoffset: 218; } to { stroke-dashoffset: 0; } }
  @keyframes beat { 0%, 100% { transform: scale(1); } 15% { transform: scale(1.25); } 30% { transform: scale(1); } }

  @media (max-width: 960px) {
    .hero-inner, .showcase { grid-template-columns: 1fr; }
    .duo { height: 280px; max-width: 460px; width: 100%; margin: 0 auto; }
    .emus { grid-template-columns: repeat(2, 1fr); }
    .tips { grid-template-columns: repeat(2, 1fr); }
    .rules { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .hero-inner { padding-top: 48px; }
    .steps, .rules, .tips { grid-template-columns: 1fr; }
    .chain { top: 120px; }
  }
</style>
